Subject: [PATCH] Build the 6000.0 runtime as ARM64EC with llvm-mingw

configure.ac: `aarch64-*-*` and `arm64ec-*-*` hosts (RID win-arm64, COREARCH arm64: Unity's Windows-ARM64
port sources, -lntdll -luuid; Boehm stays on for arm64ec, the Unity runtime being the Boehm build) and
the `aarch64-*mingw*|arm64ec-*mingw*` target (TARGET=ARM64, with the armv7 mingw case beside it) at the
Windows 10 API level the port's growable function tables and ARM64EC code allocation are declared at;
the collector on the compiler's atomics (--with-libatomic-ops=none for its sub-configure,
GC_BUILTIN_ATOMIC for the runtime's own compile of its private headers — the bundled libatomic_ops has
no ARM64EC backend); DebugBreak as the Windows BREAKPOINT; the configure-time
scripts/update_submodules.sh call dropped (the tree is assembled from pinned sources).

etw-profiler.c, mono-log-common.c: the Windows SDK header spellings as the SDK ships them, and the
MSVC-only inline forms the message-compiler output assumes, for clang. boehm-gc.c: the pointer types
the collector's current headers declare. mixed_callstack_plugin.c: a forward declaration with the
definition's linkage. oop.c: part of the Windows build (Makefile.am win32_sources), its x64
dynamic-function-table access compiled only for x64 (the ARM64 port registers its own tables).

diff --git a/configure.ac b/configure.ac
index 196e0df1..24a5e0bd 100644
--- a/configure.ac
+++ b/configure.ac
@@ -178,12 +178,34 @@ case "$host" in
 			RID="win-x64"
 			COREARCH="x64"
 			;;
+		aarch64-*-*)
+			support_boehm=no
+			with_gc=sgen
+			RID="win-arm64"
+			COREARCH="arm64"
+			;;
+		arm64ec-*-*)
+			# ARM64EC: the x64-facing build of the Windows-ARM64 port; Boehm stays on (it is the Unity runtime).
+			RID="win-arm64"
+			COREARCH="arm64"
+			;;
 		esac
 
 		# Windows 7 or later is required
 		WIN32_CPPFLAGS="-DWINVER=0x0601 -D_WIN32_WINNT=0x0601 -D_WIN32_IE=0x0501 -D_UNICODE -DUNICODE -DWIN32_THREADS -DFD_SETSIZE=1024"
+		case "$host" in
+			aarch64-*mingw*|arm64ec-*mingw*)
+				# Windows on ARM64 is Windows 10 or later; the ARM64 port's growable function tables
+				# (RtlAddGrowableFunctionTable, Windows 8) and ARM64EC code allocation (VirtualAlloc2,
+				# Windows 10 RS4) are declared only at that API level.
+				WIN32_CPPFLAGS="-DWINVER=0x0A00 -D_WIN32_WINNT=0x0A00 -DNTDDI_VERSION=0x0A000005 -D_WIN32_IE=0x0501 -D_UNICODE -DUNICODE -DWIN32_THREADS -DFD_SETSIZE=1024"
+				;;
+		esac
 		CPPFLAGS="$CPPFLAGS $WIN32_CPPFLAGS"
 		WIN32_LDFLAGS="-lbcrypt -lmswsock -lws2_32 -lole32 -loleaut32 -lpsapi -lversion -ladvapi32 -lwinmm -lkernel32 -liphlpapi -static-libgcc"
+		if test x"$COREARCH" = xarm64; then
+			WIN32_LDFLAGS="$WIN32_LDFLAGS -lntdll -luuid"
+		fi;
 		LDFLAGS="$LDFLAGS $WIN32_LDFLAGS"
 		libmono_cflags="-mms-bitfields -mwindows"
 		libmono_ldflags="-mms-bitfields -mwindows"
@@ -2137,7 +2159,16 @@ if test "x$support_boehm" = "xyes"; then
 	# TODO: How much of this do we want?
 	#		ac_configure_args="$ac_configure_args --enable-thread-local-alloc=no --enable-parallel-mark=no --enable-verify-defines=yes --enable-gc-threads=yes --with-libatomic-ops=no --enable-no-threads-discovery=yes --enable-single-obj-compilation=yes --enable-gcj-support=yes --enable-threads=$libgc_threads --enable-munmap=yes --enable-mmap=yes --enable-ignore-dynamic-loading=yes --enable-dont-register-main-static-data=yes"
 
-	ac_configure_args="$ac_configure_args --with-libatomic-ops=no"
+	case "$host" in
+		arm64ec-*mingw*)
+			# The bundled libatomic_ops has no ARM64EC backend (it picks its x86 inline-assembly
+			# sysdeps from __x86_64__); bdwgc's compiler intrinsics path needs nothing from it.
+			ac_configure_args="$ac_configure_args --with-libatomic-ops=none"
+			;;
+		*)
+			ac_configure_args="$ac_configure_args --with-libatomic-ops=no"
+			;;
+	esac
 
 	gc_msg=""
 	LIBGC_CPPFLAGS=
@@ -2146,6 +2177,14 @@ if test "x$support_boehm" = "xyes"; then
 	case "x$libgc" in
 		xincluded)
 			LIBGC_CPPFLAGS='-I$(top_srcdir)/external/bdwgc/include -I$(top_srcdir)/external/bdwgc/libatomic_ops/src'
+			case "$host" in
+				arm64ec-*mingw*)
+					# boehm-gc.c includes bdwgc's private headers; with the sub-configure on compiler
+					# intrinsics (--with-libatomic-ops=none above) the runtime's compile must say so too,
+					# or gc_atomic_ops.h pulls libatomic_ops' x86 sysdeps.
+					LIBGC_CPPFLAGS="$LIBGC_CPPFLAGS -DGC_BUILTIN_ATOMIC"
+					;;
+			esac
 			LIBGC_LIBS='$(top_builddir)/external/bdwgc/libgc.la'
 			LIBGC_STATIC_LIBS='$(top_builddir)/external/bdwgc/libgc-static.la'
 
@@ -4616,6 +4655,19 @@ case "$host" in
 			AC_MSG_ERROR([The required utility 'ar' is not found in your PATH. Usually it can be found in /usr/ccs/bin.])
 		fi
 		;;
+	armv7-*mingw*)
+		TARGET=ARM;
+		arch_target=arm;
+		ACCESS_UNALIGNED="no"
+		BTLS_SUPPORTED=no
+		BTLS_PLATFORM=arm
+		;;
+	aarch64-*mingw*|arm64ec-*mingw*)
+		TARGET=ARM64;
+		arch_target=arm64;
+		BTLS_SUPPORTED=no
+		BTLS_PLATFORM=aarch64
+		;;
 	*-mingw*|*-*-cygwin*)
 		# When this is enabled, it leads to very strange crashes at runtime (gcc-3.4.4)
 		have_visibility_hidden=no
@@ -5246,6 +5298,9 @@ AC_SUBST(libsuffix)
 GNUC_PRETTY=
 GNUC_UNUSED=
 BREAKPOINT="G_STMT_START { raise (SIGTRAP); } G_STMT_END"
+if test x$target_win32 = xyes; then
+   BREAKPOINT="G_STMT_START { DebugBreak(); } G_STMT_END"
+fi
 if test x$GCC = xyes; then
    GNUC_UNUSED='__attribute__((__unused__))'
    GNUC_NORETURN='__attribute__((__noreturn__))'
@@ -6987,11 +7042,6 @@ AC_SUBST(LDFLAGS)
 AC_SUBST(CCLDFLAGS)
 AC_SUBST(ZLIB_CFLAGS)
 
-# Update all submodules recursively to ensure everything is checked out
-if test "x$with_core" != "xonly"; then
-	(cd $srcdir && scripts/update_submodules.sh)
-fi
-
 AC_MONO_OUTPUT()
 
 if test x$host_win32 = xyes; then
