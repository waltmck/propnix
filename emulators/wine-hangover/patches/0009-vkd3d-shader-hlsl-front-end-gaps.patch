+static int compile_method_text(struct hlsl_ctx *ctx, const struct hlsl_type *type,
+        const char *text, const struct vkd3d_shader_location *loc)
+{
+    const struct hlsl_ir_function_decl *saved_cur_function = ctx->cur_function;
+    struct vkd3d_shader_code code = {.code = text, .size = strlen(text)};
+    const char *saved_internal_func_name = ctx->internal_func_name;
+    const struct hlsl_type *saved_method_type = ctx->method_type;
+    struct vkd3d_shader_location saved_location = ctx->location;
+    unsigned int saved_struct_body_depth = ctx->struct_body_depth;
+    bool saved_struct_kw_pending = ctx->struct_kw_pending;
+    void *saved_scanner = ctx->scanner;
+    int ret;
+
+    TRACE("%s\n", debugstr_a(text));
+
+    hlsl_push_scope(ctx);
+    ctx->scanner = NULL;
+    ctx->internal_func_name = NULL;
+    ctx->cur_function = NULL;
+    ctx->method_type = type;
+    ctx->struct_body_depth = 0;
+    ctx->struct_kw_pending = false;
+    ctx->location = *loc;
+    ret = hlsl_lexer_compile(ctx, &code);
+    ctx->scanner = saved_scanner;
+    ctx->internal_func_name = saved_internal_func_name;
+    ctx->cur_function = saved_cur_function;
+    ctx->method_type = saved_method_type;
+    ctx->struct_body_depth = saved_struct_body_depth;
+    ctx->struct_kw_pending = saved_struct_kw_pending;
+    ctx->location = saved_location;
+    hlsl_pop_scope(ctx);
+    return ret;
+}
+
+/* Split "<ret> <name>(<params>) {<body>}" into its parts; a parameter list containing parentheses
+ * is not supported. */
+static bool split_method_source(const char *text, size_t *ret_len, const char **name, size_t *name_len,
+        const char **params, size_t *params_len, const char **body)
+{
+    const char *open, *close, *end, *start;
+    unsigned int depth = 0;
+
+    if (!(open = strchr(text, '(')))
+        return false;
+    for (end = open; end > text && isspace((unsigned char)end[-1]); --end);
+    for (start = end; start > text && (isalnum((unsigned char)start[-1]) || start[-1] == '_'); --start);
+    if (start == end)
+        return false;
+    for (close = open; *close; ++close)
+    {
+        if (*close == '(')
+            ++depth;
+        else if (*close == ')' && !--depth)
+            break;
+    }
+    if (!*close || depth)
+        return false;
+    *ret_len = start - text;
+    *name = start;
+    *name_len = end - start;
+    *params = open + 1;
+    *params_len = close - open - 1;
+    *body = close + 1;
+    return true;
+}
