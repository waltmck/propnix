+    const xdg_activation_token_v1_listener CWaylandConnector::s_XdgActivationTokenListener =
+    {
+        .done = WAYLAND_USERDATA_TO_THIS( CWaylandConnector, XdgActivationToken_Done ),
+    };
+    void CWaylandConnector::Activate( const std::string &sToken )
+    {
+        xdg_activation_v1 *pActivation = m_pBackend->GetXdgActivation();
+        if ( !pActivation )
+            return;
+
+        wl_surface *pSurface = m_Planes[0].GetSurface();
+        if ( !sToken.empty() )
+        {
+            xdg_activation_v1_activate( pActivation, sToken.c_str(), pSurface );
+        }
+        else
+        {
+            // Stamped with the serial of the last input event on the backend's own seat, named alongside it.
+            // We hold more than one wl_seat (the input thread binds its own, libdecor another), and each gets its
+            // own serials for the same event; a host may check the serial against our first-bound seat only
+            // (Hyprland does), which is this one.
+            xdg_activation_token_v1 *pToken = xdg_activation_v1_get_activation_token( pActivation );
+            xdg_activation_token_v1_add_listener( pToken, &s_XdgActivationTokenListener, this );
+            if ( m_pBackend->m_uLastInputSerial )
+                xdg_activation_token_v1_set_serial( pToken, m_pBackend->m_uLastInputSerial, m_pBackend->m_pSeat );
+            xdg_activation_token_v1_set_surface( pToken, pSurface );
+            xdg_activation_token_v1_set_app_id( pToken, g_sAppId );
+            xdg_activation_token_v1_commit( pToken );
+        }
+        wl_display_flush( m_pBackend->GetDisplay() );
+    }
+    void CWaylandConnector::XdgActivationToken_Done( xdg_activation_token_v1 *pToken, const char *pszToken )
+    {
+        // A host that refuses the request answers with an empty token; one that grants less (urgency only, for
+        // a serial it cannot match) decides that itself when we activate.
+        if ( pszToken && *pszToken )
+            xdg_activation_v1_activate( m_pBackend->GetXdgActivation(), pszToken, m_Planes[0].GetSurface() );
+        xdg_activation_token_v1_destroy( pToken );
+        wl_display_flush( m_pBackend->GetDisplay() );
+    }
     void CWaylandConnector::SetIcon( std::shared_ptr<std::vector<uint32_t>> uIconPixels )
     {
         if ( !m_pBackend->GetToplevelIconManager() )
@@ -2623,6 +2675,10 @@ namespace gamescope
