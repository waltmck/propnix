 		if ( !IsGamescopeToplevel( pSurface ) )
diff --git a/src/backend.h b/src/backend.h
index a1546c1..fed06e8 100644
--- a/src/backend.h
+++ b/src/backend.h
@@ -210,6 +210,11 @@ namespace gamescope
 
         virtual INestedHints *GetNestedHints() = 0;
 
+        // Ask the host to focus this connector's window (xdg-activation). `sToken` is an activation token from
+        // whoever wants it focused; empty → request one with our own last input serial, which the host may
+        // honour only as an attention request. A no-op on a backend with no host window.
+        virtual void Activate( const std::string &sToken ) {}
+
         virtual void SetProperty( ConnectorProperty eProperty, std::any value ) = 0;
     };
 
diff --git a/src/steamcompmgr.cpp b/src/steamcompmgr.cpp
index 0c2a768..8af1be4 100644
--- a/src/steamcompmgr.cpp
+++ b/src/steamcompmgr.cpp
@@ -7492,6 +7492,26 @@ handle_property_notify(xwayland_ctx_t *ctx, XPropertyEvent *ev)
 			g_flHDRItmTargetNits = 10000.f;
 		hasRepaint = true;
 	}
+	if ( ev->atom == ctx->atoms.gamescopeXdgActivationToken )
+	{
+		// Someone (a second launch of the game) wants our window focused: the value is its xdg-activation
+		// token, empty when it has none. Read and delete in one request, so the PropertyDelete this causes
+		// finds nothing and every request is acted on exactly once.
+		Atom actualType = None;
+		int nActualFormat = 0;
+		unsigned long ulItems = 0, ulBytesAfter = 0;
+		unsigned char *pData = nullptr;
+		if ( XGetWindowProperty( ctx->dpy, ctx->root, ctx->atoms.gamescopeXdgActivationToken, 0, 1024, True,
+				AnyPropertyType, &actualType, &nActualFormat, &ulItems, &ulBytesAfter, &pData ) == Success &&
+			actualType != None )
+		{
+			std::string sToken = ( pData && nActualFormat == 8 ) ? std::string( (const char *)pData, ulItems ) : std::string();
+			if ( gamescope::IBackendConnector *pConnector = GetBackend()->GetCurrentConnector() )
+				pConnector->Activate( sToken );
+		}
+		if ( pData )
+			XFree( pData );
+	}
 	if ( ev->atom == ctx->atoms.gamescopeKeyboardLayout )
 	{
 		std::string sLayout = get_string_prop( ctx, ctx->root, ctx->atoms.gamescopeKeyboardLayout );
@@ -9167,6 +9187,7 @@ void init_xwayland_ctx(uint32_t serverId, gamescope_xwayland_server_t *xwayland_
 	ctx->atoms.gamescopeSharpness = XInternAtom( ctx->dpy, "GAMESCOPE_SHARPNESS", false );
 
 	ctx->atoms.gamescopeXWaylandModeControl = XInternAtom( ctx->dpy, "GAMESCOPE_XWAYLAND_MODE_CONTROL", false );
+	ctx->atoms.gamescopeXdgActivationToken = XInternAtom( ctx->dpy, "GAMESCOPE_XDG_ACTIVATION_TOKEN", false );
 	ctx->atoms.gamescopeFPSLimit = XInternAtom( ctx->dpy, "GAMESCOPE_FPS_LIMIT", false );
 	ctx->atoms.gamescopeKeyboardLayout = XInternAtom( ctx->dpy, "GAMESCOPE_KEYBOARD_LAYOUT", false );
 	ctx->atoms.gamescopeLimiterFeedback = XInternAtom( ctx->dpy, "GAMESCOPE_LIMITER_FEEDBACK", false );
