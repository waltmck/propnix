+        auto SearchResult = Region->UsedPages.ForwardScanForRange<true>(LastAllocation, ScanPages, RegionNumberOfPages);
         AllocatedPage = SearchResult.FoundElement;
       }

       if (AllocatedPage != ~0ULL) {
+        // Safe because the scan reserved `ScanPages`: rounding up moves the start by at most
+        // PagesPerHostPage - 1, so the NumberOfPages we actually map remain inside the free run.
+        AllocatedPage = FEXCore::AlignUp(AllocatedPage, PagesPerHostPage);
         AllocatedOffset = Region->SlabInfo->Base + AllocatedPage * FEXCore::Utils::FEX_PAGE_SIZE;

