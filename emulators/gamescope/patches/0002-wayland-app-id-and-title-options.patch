Subject: [PATCH] wayland: --app-id and --title for the host toplevel

The Wayland backend's toplevel always carries app_id "gamescope" and the focused app's title, so every
nested app shares one identity on the host: one taskbar group, one icon, and no way for a launcher to map
the window to its own desktop entry.

--app-id sets the toplevel's app_id (default "gamescope"), at creation and again when it is restored after
a NULL-buffer unmap. --title fixes its title (default: follow the focused app's title, as before).
diff --git a/src/Backends/WaylandBackend.cpp b/src/Backends/WaylandBackend.cpp
index bc9293d..9b20a8d 100644
--- a/src/Backends/WaylandBackend.cpp
+++ b/src/Backends/WaylandBackend.cpp
@@ -1282,6 +1282,12 @@ namespace gamescope
     }
     void CWaylandConnector::SetTitle( std::shared_ptr<std::string> pAppTitle )
     {
+        if ( g_sAppTitle )
+        {
+            libdecor_frame_set_title( m_Planes[0].GetFrame(), g_sAppTitle );
+            return;
+        }
+
         std::string szTitle = pAppTitle ? *pAppTitle : "gamescope";
         if ( g_bGrabbed )
             szTitle += " (grabbed)";
@@ -1445,8 +1451,8 @@ namespace gamescope
         {
 			wl_proxy_set_tag( (wl_proxy *)m_pSurface, &GAMESCOPE_toplevel_tag );
             m_pFrame = libdecor_decorate( m_pBackend->GetLibDecor(), m_pSurface, &s_LibDecorFrameInterface, this );
-            libdecor_frame_set_title( m_pFrame, "Gamescope" );
-            libdecor_frame_set_app_id( m_pFrame, "gamescope" );
+            libdecor_frame_set_title( m_pFrame, g_sAppTitle ? g_sAppTitle : "Gamescope" );
+            libdecor_frame_set_app_id( m_pFrame, g_sAppId );
             libdecor_frame_map( m_pFrame );
         }
         else
@@ -1675,7 +1681,7 @@ namespace gamescope
         // Unmapping resets the toplevel, so restore it before the next initial commit.
         if ( m_bToplevelStateReset )
         {
-            libdecor_frame_set_app_id( m_pFrame, "gamescope" );
+            libdecor_frame_set_app_id( m_pFrame, g_sAppId );
             // libdecor skips a title it already sent.
             xdg_toplevel_set_title( GetXdgToplevel(), libdecor_frame_get_title( m_pFrame ) );
             m_bToplevelStateReset = false;
