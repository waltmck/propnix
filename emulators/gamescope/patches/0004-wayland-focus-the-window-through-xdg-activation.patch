             m_pToplevelIconManager = (xdg_toplevel_icon_manager_v1 *)wl_registry_bind( pRegistry, uName, &xdg_toplevel_icon_manager_v1_interface, 1u );
         }
+        else if ( !strcmp( pInterface, xdg_activation_v1_interface.name ) )
