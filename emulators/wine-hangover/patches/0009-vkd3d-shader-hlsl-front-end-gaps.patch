+/* Every method is first declared, so that a body may call a method defined later in the struct,
+ * then defined. */
+bool hlsl_compile_struct_methods(struct hlsl_ctx *ctx, const struct hlsl_type *type,
+        const struct hlsl_method_source *methods, size_t count)
+{
+    unsigned int pass;
+    size_t i;
+
+    for (pass = 0; pass < 2; ++pass)
+    {
+        for (i = 0; i < count; ++i)
+        {
+            const char *name, *params, *body, *separator;
+            size_t ret_len, name_len, params_len, j;
+            char *mangled, *short_name, *text;
+            bool blank = true;
+            int ret;
+
+            if (!split_method_source(methods[i].text, &ret_len, &name, &name_len, &params, &params_len, &body))
+            {
+                hlsl_error(ctx, &methods[i].loc, VKD3D_SHADER_ERROR_HLSL_INVALID_SYNTAX,
+                        "Unsupported method declaration in struct \"%s\".", type->name);
+                return false;
+            }
+            for (j = 0; j < params_len; ++j)
+                blank = blank && isspace((unsigned char)params[j]);
+            separator = blank ? "" : ", ";
+
+            if (!(short_name = hlsl_sprintf_alloc(ctx, "%.*s", (int)name_len, name)))
+                return false;
+            mangled = hlsl_method_name(ctx, type, short_name);
+            vkd3d_free(short_name);
+            if (!mangled)
+                return false;
+            text = hlsl_sprintf_alloc(ctx, "%.*s %s(inout %s __this%s%.*s)%s", (int)ret_len, methods[i].text,
+                    mangled, type->name, separator, (int)params_len, params, pass ? body : ";");
+            vkd3d_free(mangled);
+            if (!text)
+                return false;
+            ret = compile_method_text(ctx, type, text, &methods[i].loc);
+            vkd3d_free(text);
+            if (ret)
+            {
+                hlsl_error(ctx, &methods[i].loc, VKD3D_SHADER_ERROR_HLSL_INVALID_SYNTAX,
+                        "Failed to compile method of struct \"%s\".", type->name);
+                return false;
+            }
+        }
+    }
+    return true;
+}
