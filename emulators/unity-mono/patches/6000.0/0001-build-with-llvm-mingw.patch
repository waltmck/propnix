 	w32socket-win32.c \
 	w32error-win32.c
 
diff --git a/mono/metadata/boehm-gc.c b/mono/metadata/boehm-gc.c
index 4a012db8..3f65df05 100644
--- a/mono/metadata/boehm-gc.c
+++ b/mono/metadata/boehm-gc.c
@@ -1175,7 +1175,7 @@ mono_gc_wbarrier_object_copy_internal (MonoObject* obj, MonoObject *src)
 void
 mono_gc_clear_domain (MonoDomain *domain)
 {
-	GC_call_with_alloc_lock (null_ephemerons_for_domain, domain);
+	GC_call_with_alloc_lock ((GC_fn_type)null_ephemerons_for_domain, domain);
 }
 
 void
@@ -2202,7 +2202,7 @@ mono_push_ephemerons (struct GC_ms_entry* mark_stack_ptr, struct GC_ms_entry* ma
 				continue;
 
 			if (current_ephemeron->value) {
-				mark_stack_ptr = GC_mark_and_push(current_ephemeron->value, mark_stack_ptr, mark_stack_limit, &current_ephemeron->value);
+				mark_stack_ptr = GC_mark_and_push(current_ephemeron->value, mark_stack_ptr, mark_stack_limit, (void **)&current_ephemeron->value);
 			}
 		}
 	}
diff --git a/mono/metadata/etw-profiler.c b/mono/metadata/etw-profiler.c
index 80d969ba..cde626dc 100644
--- a/mono/metadata/etw-profiler.c
+++ b/mono/metadata/etw-profiler.c
@@ -37,12 +37,23 @@
 #include <string.h>
 
 #define WIN32_LEAN_AND_MEAN
-#include "Evntcons.h"
+#include <evntcons.h>
 #include "evntprov.h"
 #include "evntrace.h"
 #include "cguid.h"
 #include "windows.h"
 
+/* The message-compiler output and this file define their helpers as plain `__inline`: C99 inline definitions
+ * emit no symbol under clang/gcc (MSVC treats them as static), so make every such helper static, before the
+ * first declaration. */
+#define ETW_INLINE static __inline
+#undef DECLSPEC_NOINLINE
+#define DECLSPEC_NOINLINE static __attribute__ ((noinline))
+
+/* Calls the external-only API from inside the runtime; MSVC has no deprecation attribute for that, clang and gcc
+ * do, and mono-publib.h arms it after its own include, so the suppression must follow the includes. */
+#pragma GCC diagnostic ignored "-Wdeprecated-declarations"
+
 DECLSPEC_NOINLINE __inline VOID __stdcall Private_EventControlCallback (_In_ LPCGUID SourceId, _In_ ULONG ControlCode, _In_ UCHAR Level, _In_ ULONGLONG MatchAnyKeyword, _In_ ULONGLONG MatchAllKeyword, _In_opt_ PEVENT_FILTER_DESCRIPTOR FilterData, _Inout_opt_ PVOID CallbackContext);
 #define MCGEN_PRIVATE_ENABLE_CALLBACK_V2 Private_EventControlCallback
 #include "CLR-ETW-Generated.h"
diff --git a/mono/metadata/oop.c b/mono/metadata/oop.c
index 92036b11..b4650e24 100644
--- a/mono/metadata/oop.c
+++ b/mono/metadata/oop.c
@@ -36,7 +36,7 @@
 #include <mono/metadata/coree.h>
 
 
-#ifdef _WIN64
+#if defined(_WIN64) && !defined(__arm64ec__) /* the x64 dynamic function tables; the ARM64 port keeps its own */
 #include <mono/mini/mini.h>
 extern GList* g_dynamic_function_table_begin;
 extern SRWLOCK g_dynamic_function_table_lock;
@@ -154,7 +154,7 @@ mono_unity_oop_shutdown(void)
     memset(&g_oop, 0, sizeof(g_oop));
 }
 
-#ifdef _WIN64
+#if defined(_WIN64) && !defined(__arm64ec__) /* the x64 dynamic function tables; the ARM64 port keeps its own */
 gboolean TryAcquireSpinWait(PSRWLOCK lock, unsigned int spinWait)
 {
     do
@@ -170,7 +170,7 @@ gboolean TryAcquireSpinWait(PSRWLOCK lock, unsigned int spinWait)
 MONO_API GList*
 mono_unity_lock_dynamic_function_access_tables64(unsigned int spinWait) 
 {
-#ifdef _WIN64
+#if defined(_WIN64) && !defined(__arm64ec__) /* the x64 dynamic function tables; the ARM64 port keeps its own */
     if (spinWait >= 0x7fffffff) {
         AcquireSRWLockExclusive(&g_dynamic_function_table_lock);
     }
@@ -186,7 +186,7 @@ mono_unity_lock_dynamic_function_access_tables64(unsigned int spinWait)
 MONO_API void
 mono_unity_unlock_dynamic_function_access_tables64(void) 
 {
-#ifdef _WIN64
+#if defined(_WIN64) && !defined(__arm64ec__) /* the x64 dynamic function tables; the ARM64 port keeps its own */
     ReleaseSRWLockExclusive(&g_dynamic_function_table_lock);
 #else
     return;
@@ -197,7 +197,7 @@ MONO_API GList*
 mono_unity_oop_iterate_dynamic_function_access_tables64(
     GList* current) 
 {
-#ifdef _WIN64
+#if defined(_WIN64) && !defined(__arm64ec__) /* the x64 dynamic function tables; the ARM64 port keeps its own */
     if (current != NULL)
         return read_glist_next(current);
     else
@@ -215,7 +215,7 @@ mono_unity_oop_get_dynamic_function_access_table64(
     void** functionTable,
     gsize* functionTableSize)
 {
-#ifdef _WIN64
+#if defined(_WIN64) && !defined(__arm64ec__) /* the x64 dynamic function tables; the ARM64 port keeps its own */
     if (!tableEntry || !moduleStart || !moduleEnd || !functionTable || !functionTableSize)
         return FALSE;
 
diff --git a/mono/mini/mixed_callstack_plugin.c b/mono/mini/mixed_callstack_plugin.c
