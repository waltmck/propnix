+/* offset of a shared section inside the temp file, given the offset the previous one ended at
+ *
+ * The layout is ours to choose (the temp file is created here), and a client on a host whose pages are
+ * larger than the image's cannot mmap() a section whose address and file offset are incongruent modulo
+ * the HOST page size: it can only round both down to a host page boundary, which requires
+ * offset % host_page == address % host_page. So place every section at an offset congruent to its
+ * virtual address, padding with the zeroes create_temp_file() already gives us.
+ *
+ * On a host whose pages are 4k this is a no-op: section addresses are multiples of the (>= 4k) section
+ * alignment and every map_size is rounded to it, so the congruence already holds and no padding is
+ * emitted. The file layout there stays byte-for-byte what it was. */
+static inline off_t shared_section_pos( off_t end_of_prev, const IMAGE_SECTION_HEADER *sec )
+{
+    return end_of_prev + ((sec->VirtualAddress - end_of_prev) & host_page_mask);
+}
