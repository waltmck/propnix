   uint16_t Test {};
 
-  auto now = std::chrono::high_resolution_clock::now();
+  auto now = std::chrono::steady_clock::now();
   FEXCore::Utils::SpinWaitLock::Wait(&Test, 1, SleepAmount);
-  auto end = std::chrono::high_resolution_clock::now();
+  auto end = std::chrono::steady_clock::now();
   auto diff = end - now;
 
-  // The futex spinwait needs to have slept for at /least/ the amount specified. It will always run slightly late.
-  REQUIRE(std::chrono::duration_cast<std::chrono::nanoseconds>(diff) >= std::chrono::duration_cast<std::chrono::nanoseconds>(SleepAmount));
+  // The futex spinwait needs to have slept for at /least/ the amount specified, less the cross-clock
+  // tolerance above. It will always run slightly late.
+  REQUIRE(std::chrono::duration_cast<std::chrono::nanoseconds>(diff) >=
+          std::chrono::duration_cast<std::chrono::nanoseconds>(SleepAmount - SleepTolerance));
 }
 
