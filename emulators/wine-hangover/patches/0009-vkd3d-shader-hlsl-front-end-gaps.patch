+static bool prepend_this_argument(struct hlsl_ctx *ctx, struct parse_initializer *args,
+        struct hlsl_ir_var *this_var, const struct vkd3d_shader_location *loc)
+{
+    struct hlsl_ir_node **new_args;
+
+    if (!(new_args = vkd3d_realloc(args->args, (args->args_count + 1) * sizeof(*new_args))))
+        return false;
+    args->args = new_args;
+    memmove(args->args + 1, args->args, args->args_count * sizeof(*args->args));
+    args->args[0] = hlsl_block_add_simple_load(ctx, args->instrs, this_var, loc);
+    ++args->args_count;
+    return true;
