Subject: [PATCH] --no-hotkeys: pass every key to the app in the nested backends

The Wayland and SDL backends hard-code Super+key shortcuts (fullscreen, filters, sharpness, screenshot,
grab): while gamescope has keyboard focus, those key presses are consumed and never reach the app, and no
option turns them off. A launcher that runs every game in gamescope wants the game to see all of its
keys, and leaves window management (fullscreen included) to the host compositor.

--no-hotkeys disables them: every key is forwarded to the app.
diff --git a/src/Backends/SDLBackend.cpp b/src/Backends/SDLBackend.cpp
index d35e218..3f7b431 100644
--- a/src/Backends/SDLBackend.cpp
+++ b/src/Backends/SDLBackend.cpp
@@ -743,7 +743,7 @@ namespace gamescope
 				{
 					// If this keydown event is super + one of the shortcut keys, consume the keydown event, since the corresponding keyup
 					// event will be consumed by the next case statement when the user releases the key
-					if ( event.key.keysym.mod & KMOD_LGUI )
+					if ( !g_bNoHotkeys && ( event.key.keysym.mod & KMOD_LGUI ) )
 					{
 						uint32_t key = SDLScancodeToLinuxKey( event.key.keysym.scancode );
 						const uint32_t shortcutKeys[] = {KEY_F, KEY_N, KEY_B, KEY_U, KEY_Y, KEY_I, KEY_O, KEY_S, KEY_G};
@@ -759,7 +759,7 @@ namespace gamescope
 				{
 					uint32_t key = SDLScancodeToLinuxKey( event.key.keysym.scancode );
 
-					if ( event.type == SDL_KEYUP && ( event.key.keysym.mod & KMOD_LGUI ) )
+					if ( !g_bNoHotkeys && event.type == SDL_KEYUP && ( event.key.keysym.mod & KMOD_LGUI ) )
 					{
 						bool handled = true;
 						switch ( key )
diff --git a/src/Backends/WaylandBackend.cpp b/src/Backends/WaylandBackend.cpp
index 58c35c1..8811a45 100644
--- a/src/Backends/WaylandBackend.cpp
+++ b/src/Backends/WaylandBackend.cpp
@@ -3082,7 +3082,7 @@ namespace gamescope
         {
             m_uScancodesHeld.insert( uKey );
 
-            if ( ( m_uKeyModifiers & m_uModMask[ GAMESCOPE_WAYLAND_MOD_META ] ) && IsHotkey( uKey ) )
+            if ( !g_bNoHotkeys && ( m_uKeyModifiers & m_uModMask[ GAMESCOPE_WAYLAND_MOD_META ] ) && IsHotkey( uKey ) )
             {
                 m_uScancodesConsumed.insert( uKey );
                 return;
