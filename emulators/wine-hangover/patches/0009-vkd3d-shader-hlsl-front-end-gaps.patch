+/* A struct method is compiled as a free function under this name, with the object as its first
+ * parameter ("inout <struct> __this"); the lexer cannot produce the "::" spelling. */
+char *hlsl_method_name(struct hlsl_ctx *ctx, const struct hlsl_type *type, const char *name)
+{
+    if (!type->name)
+        return NULL;
+    return hlsl_sprintf_alloc(ctx, "__%s__%s", type->name, name);
+}
