+/* offset of a writable shared section inside the shared temp file
+ *
+ * MUST match the server's shared_section_pos() byte for byte — the server lays the file out and the
+ * client reads it back by recomputing the same offsets. See the comment there for why the layout is
+ * congruent to each section's virtual address. */
+static inline off_t shared_section_pos( off_t end_of_prev, const IMAGE_SECTION_HEADER *sec )
+{
+    return end_of_prev + ((sec->VirtualAddress - end_of_prev) & host_page_mask);
+}
+
+
+/* can a writable shared section be mapped on the enclosing HOST pages without disturbing anything else?
+ *
+ * Rounding a section's span out to whole host pages is only safe when those extra bytes belong to no
+ * other section: they will be served from the shared temp file, so any section sharing the host page
+ * would have its contents replaced (and its protection and cross-process semantics changed with them).
+ * A game whose shared section sits alone in its host page therefore keeps working sharing; one whose
+ * shared section shares a host page with, say, the tail of .pdata and the head of a code section does
+ * not, and map_file_into_view falls back to a private mapping. */
+static BOOL shared_section_is_page_isolated( const IMAGE_SECTION_HEADER *sec, unsigned int nb_sec,
+                                             unsigned int idx, SIZE_T align_mask, SIZE_T total_size )
+{
+    SIZE_T lo, hi, i;
+
+    if (host_page_mask <= page_mask) return FALSE;  /* nothing to round out to */
+
+    lo = sec[idx].VirtualAddress & ~(SIZE_T)host_page_mask;
+    hi = lo + ROUND_SIZE( sec[idx].VirtualAddress,
+                          sec[idx].Misc.VirtualSize ? sec[idx].Misc.VirtualSize : sec[idx].SizeOfRawData,
+                          host_page_mask );
+    if (hi > total_size) return FALSE;  /* would map outside the image view */
+
+    for (i = 0; i < nb_sec; i++)
+    {
+        SIZE_T start, end, size;
+
+        if (i == idx) continue;
+        size = sec[i].Misc.VirtualSize ? sec[i].Misc.VirtualSize : sec[i].SizeOfRawData;
+        if (!size) continue;
+        start = sec[i].VirtualAddress;
+        end = start + ROUND_SIZE( 0, size, align_mask );
+        if (start < hi && end > lo) return FALSE;
+    }
+    return TRUE;
+}
