+static void count_lines(struct hlsl_ctx *ctx, const char *text, size_t len)
+{
+    size_t i, last = 0;
+    unsigned int lines = 0;
+
+    for (i = 0; i < len; ++i)
+    {
+        if (text[i] == '\n')
+        {
+            ++lines;
+            last = i + 1;
+        }
+    }
+    if (lines)
+    {
+        ctx->location.line += lines;
+        ctx->location.column = 1 + (len - last);
+    }
+}
