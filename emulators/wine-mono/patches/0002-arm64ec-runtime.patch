 	return emit_imm64 (code, dreg, imm);
 }
 
+#ifdef __arm64ec__
+/*
+ * ARM64EC — the two transitions between JIT'd ARM64 code and x64 code.
+ *
+ * JIT'd managed code is plain ARM64 and calls other managed code and the runtime's own (EC) C code
+ * directly. The two places where x64 code can be on the other side are:
+ *
+ *   OUT: a p/invoke target. It may be an ARM64X system DLL's x64-facing export (a fast-forward stub
+ *        whose bytes are x64, with an EC implementation behind it) or a genuinely x64 DLL. Compiled EC
+ *        code routes every indirect call through the OS checker __os_arm64x_check_icall (wine:
+ *        arm64x_check_call): x11 = target, x10 = the exit thunk for this call's signature; it returns
+ *        x11 = an address safe to `blr` — the target itself when it is EC code, the EC implementation
+ *        behind a fast-forward stub (system calls stay native), or x10 with x9 = the x64 target. The
+ *        exit thunk re-marshals the EC-convention arguments into the x64 convention and runs the target
+ *        under the emulator (__os_arm64x_dispatch_call_no_redirect).
+ *
+ *   IN:  a native-to-managed wrapper whose address was handed to native code (delegate -> function
+ *        pointer). When x64 code calls it, the emulator looks for an ENTRY THUNK through the 4-byte
+ *        offset stored immediately before the function's first instruction (bit 0 set), so mono_codegen
+ *        reserves a prefix in front of every such wrapper and the thunk emitted there re-marshals the x64
+ *        arguments into the wrapper's AAPCS64 layout, calls it (x9), and returns through
+ *        __os_arm64x_dispatch_ret with the result in x8 (rax).
+ *
+ * Register mapping between the two conventions, which the thunks rely on: rcx/rdx/r8/r9 = x0-x3,
+ * rax = x8, xmm0-xmm15 = v0-v15 (positional for the first four x64 arguments, by class for AAPCS64),
+ * stack arguments after the 32-byte shadow space. x64 keeps xmm6-xmm15 whole across calls where AAPCS64
+ * keeps only d8-d15, so an entry thunk saves q6-q15. The emulator owns x13, x14, x23, x24, x28 and
+ * v16-v31 (never saved in an exception/suspend context, never preserved across x64 code), which is why
+ * the register allocator masks in mini-arm64.h exclude them under __arm64ec__.
+ *
+ * Structs: x64 passes 1/2/4/8-byte structs by value in the integer slot and every other size as a
+ * pointer to a caller-owned copy; AAPCS64 packs up to 16 bytes into registers (HFAs into v registers).
+ * The thunks spill such arguments to a slot in their own frame and pass the slot (or its 8 bytes).
+ * Not handled (a trap + warning instead): varargs signatures (the EC convention for them is different).
+ */
+extern void *__os_arm64x_check_icall;
+extern void *__os_arm64x_dispatch_call_no_redirect;
+extern void *__os_arm64x_dispatch_ret;
+
+static CallInfo* get_call_info (MonoMemPool *mp, MonoMethodSignature *sig);
+
+typedef enum { X64_NONE, X64_INT, X64_FP64, X64_FP32, X64_BYPTR } X64Class;
+
+typedef struct {
+	int pos;        /* x64 argument position */
+	X64Class cls;
+	ArgInfo *ainfo; /* the AAPCS64 side */
+	int size;       /* the REAL size of an aggregate (ArgInfo.size is the 8-aligned stack size) */
+	int slot;       /* frame offset of a spilled copy, or -1 */
+} ThunkArg;
+
+/*
+ * The x64 convention keys on an aggregate's real size (6 bytes: by pointer; 8: in a register), and
+ * ArgInfo.size is the 8-aligned stack size that add_valuetype computes, so the size must come from
+ * the type (a 6-byte struct of three shorts goes by pointer; ArgInfo.size would say 8, in a register).
+ */
+static int
+arm64ec_type_size (MonoType *t, gboolean pinvoke)
+{
+	MonoType *u = mini_get_underlying_type (t);
+	guint32 align;
+
+	if (u->type == MONO_TYPE_VALUETYPE || u->type == MONO_TYPE_TYPEDBYREF ||
+	    (u->type == MONO_TYPE_GENERICINST && mono_type_generic_inst_is_valuetype (u))) {
+		MonoClass *klass = mono_class_from_mono_type_internal (u);
+		return pinvoke ? mono_class_native_size (klass, &align) : mono_class_value_size (klass, &align);
+	}
+	return 8;
+}
+
+static int
+arm64ec_arg_size (MonoMethodSignature *sig, int i)
+{
+	if (sig->hasthis) {
+		if (i == 0)
+			return 8;
+		i--;
+	}
+	return arm64ec_type_size (sig->params [i], sig->pinvoke);
+}
+
+static int
+arm64ec_align16 (int v)
+{
+	return (v + 15) & ~15;
+}
+
+/* STP/LDP of a pair of Q registers: mode 1 = post-index, 2 = signed offset, 3 = pre-index */
+static guint8*
+emit_qpair (guint8 *code, gboolean load, int rt, int rt2, int rn, int imm, int mode)
+{
+	g_assert ((imm % 16) == 0 && imm >= -1024 && imm < 1024);
+	arm_emit (code, (2 << 30) | (5 << 27) | (1 << 26) | (mode << 23) | ((load ? 1 : 0) << 22) | (((imm / 16) & 0x7f) << 15) | (rt2 << 10) | (rn << 5) | rt);
+	return code;
+}
+
+static X64Class
+arm64ec_x64_class (ArgInfo *ainfo, int size)
+{
+	switch (ainfo->storage) {
+	case ArgNone:
+		return X64_NONE;
+	case ArgInIReg:
+	case ArgOnStack:
+		return X64_INT;
+	case ArgInFReg:
+	case ArgOnStackR8:
+		return X64_FP64;
+	case ArgInFRegR4:
+	case ArgOnStackR4:
+		return X64_FP32;
+	case ArgVtypeInIRegs:
+	case ArgVtypeOnStack:
+	case ArgHFA:
+	case ArgVtypeByRef:
+	case ArgVtypeByRefOnStack:
+		return (size == 1 || size == 2 || size == 4 || size == 8) ? X64_INT : X64_BYPTR;
+	default:
+		return X64_NONE;
+	}
+}
+
+static gboolean
+arm64ec_thunk_supported (MonoMethodSignature *sig, CallInfo *cinfo, const char *what)
+{
+	int i;
+	gboolean ok = sig->call_convention != MONO_CALL_VARARG;
+
+	for (i = 0; ok && i < cinfo->nargs; ++i)
+		if (arm64ec_x64_class (&cinfo->args [i], arm64ec_arg_size (sig, i)) == X64_NONE)
+			ok = FALSE;
+	if (ok && cinfo->ret.storage != ArgNone && arm64ec_x64_class (&cinfo->ret, arm64ec_type_size (sig->ret, sig->pinvoke)) == X64_NONE)
+		ok = FALSE;
+	if (!ok) {
+		char *name = mono_signature_get_desc (sig, TRUE);
+		g_warning ("ARM64EC: %s not supported for signature %s; a call through it traps", what, name);
+		g_free (name);
+	}
+	return ok;
+}
+
+/* Copy an AAPCS64-held aggregate into the thunk frame at [sp + slot]; entry-stack arguments live at [sp + stack_base + offset]. */
+static guint8*
+arm64ec_spill_to_slot (guint8 *code, ArgInfo *ainfo, int stack_base, int slot)
+{
+	int k;
+
+	switch (ainfo->storage) {
+	case ArgVtypeInIRegs:
+		for (k = 0; k < ainfo->nregs; ++k)
+			arm_strx (code, ainfo->reg + k, ARMREG_SP, slot + k * 8);
+		break;
+	case ArgHFA:
+		for (k = 0; k < ainfo->nregs; ++k) {
+			if (ainfo->esize == 4)
+				arm_strfpw (code, ainfo->reg + k, ARMREG_SP, slot + ainfo->foffsets [k]);
+			else
+				arm_strfpx (code, ainfo->reg + k, ARMREG_SP, slot + ainfo->foffsets [k]);
+		}
+		break;
+	case ArgVtypeOnStack:
+		for (k = 0; k < ainfo->size; k += 8) {
+			arm_ldrx (code, ARMREG_IP1, ARMREG_SP, stack_base + ainfo->offset + k);
+			arm_strx (code, ARMREG_IP1, ARMREG_SP, slot + k);
+		}
+		break;
+	default:
+		g_assert_not_reached ();
+	}
+	return code;
+}
+
+/*
+ * Both thunks first copy every register-held source into an IMAGE in their own frame and only then
+ * build the destinations with loads. A register-to-register schedule would need an order in which no
+ * destination clobbers a pending source, and aggregates break every simple order: a two-float HFA at
+ * x64 position 0 lands in s0 AND s1, so writing it clobbers the float at position 1 (xmm1); a 16-byte
+ * struct in x0/x1 shifts every later integer index past its position. The image costs a few stores
+ * per call, nothing next to the emulator transition it precedes.
+ */
+#define IMG_INT(off, r) ((off) + 8 * (r))      /* x0..x7 */
+#define IMG_FP(off, r)  ((off) + 64 + 8 * (r)) /* d0..d7 */
+#define IMG_SIZE 128
+
+/* Store @nbytes (1..8) of @xreg to [base + off]; a tail of 3/5/6/7 bytes goes through [sp + tmp]. */
+static guint8*
+arm64ec_store_bytes (guint8 *code, int xreg, int base, int off, int nbytes, int tmp)
+{
+	int k;
+
+	switch (nbytes) {
+	case 8: arm_strx (code, xreg, base, off); break;
+	case 4: arm_strw (code, xreg, base, off); break;
+	case 2: arm_strh (code, xreg, base, off); break;
+	case 1: arm_strb (code, xreg, base, off); break;
+	default:
+		arm_strx (code, xreg, ARMREG_SP, tmp);
+		for (k = 0; k < nbytes; ++k) {
+			arm_ldrb (code, ARMREG_IP1, ARMREG_SP, tmp + k);
+			arm_strb (code, ARMREG_IP1, base, off + k);
+		}
+		break;
+	}
+	return code;
+}
+
+/* Load the x64 form of argument @a (from the image, a spill slot or the entry stack) into xdst or fdst. */
+static guint8*
+arm64ec_exit_value (guint8 *code, ThunkArg *a, int img, int stack_base, int xdst, int fdst)
+{
+	ArgInfo *ai = a->ainfo;
+
+	switch (a->cls) {
+	case X64_INT:
+		if (a->slot >= 0)
+			arm_ldrx (code, xdst, ARMREG_SP, a->slot);
+		else if (ai->storage == ArgInIReg || ai->storage == ArgVtypeInIRegs)
+			arm_ldrx (code, xdst, ARMREG_SP, IMG_INT (img, ai->reg));
+		else
+			arm_ldrx (code, xdst, ARMREG_SP, stack_base + ai->offset);
+		break;
+	case X64_BYPTR:
+		if (a->slot >= 0)
+			arm_addx_imm (code, xdst, ARMREG_SP, a->slot);
+		else if (ai->storage == ArgVtypeByRef)
+			arm_ldrx (code, xdst, ARMREG_SP, IMG_INT (img, ai->reg));
+		else
+			arm_ldrx (code, xdst, ARMREG_SP, stack_base + ai->offset);
+		break;
+	case X64_FP64:
+		if (ai->storage == ArgInFReg)
+			arm_ldrfpx (code, fdst, ARMREG_SP, IMG_FP (img, ai->reg));
+		else
+			arm_ldrfpx (code, fdst, ARMREG_SP, stack_base + ai->offset);
+		break;
+	case X64_FP32:
+		if (ai->storage == ArgInFRegR4)
+			arm_ldrfpw (code, fdst, ARMREG_SP, IMG_FP (img, ai->reg));
+		else
+			arm_ldrfpw (code, fdst, ARMREG_SP, stack_base + ai->offset);
+		break;
+	default:
+		g_assert_not_reached ();
+	}
+	return code;
+}
+
+/*
+ * The exit thunk for @sig. Entered from the checker's return path with the EC-convention arguments in
+ * place, x9 = the x64 target and lr = the JIT'd caller.
+ */
+static guint8*
+arm64ec_emit_exit_thunk (guint8 *code, MonoMethodSignature *sig, CallInfo *cinfo)
+{
+	int nargs = cinfo->nargs, i, k;
+	int retsize = arm64ec_type_size (sig->ret, sig->pinvoke);
+	X64Class retcls = arm64ec_x64_class (&cinfo->ret, retsize);
+	gboolean hidden = (retcls == X64_BYPTR);
+	int nstack = MAX (0, nargs + hidden - 4);
+	int img = 0x20 + 8 * nstack;
+	int spill = img + IMG_SIZE;
+	int retslot = -1, frame, stack_base;
+	ThunkArg *args = g_newa (ThunkArg, nargs + 1);
+
+	if (!arm64ec_thunk_supported (sig, cinfo, "exit thunk")) {
+		arm_brk (code, 0xec);
+		return code;
+	}
+
+	for (i = 0; i < nargs; ++i) {
+		ArgInfo *ai = &cinfo->args [i];
+		gboolean need_slot;
+
+		args [i].pos = i + hidden;
+		args [i].size = arm64ec_arg_size (sig, i);
+		args [i].cls = arm64ec_x64_class (ai, args [i].size);
+		args [i].ainfo = ai;
+		args [i].slot = -1;
+		need_slot = ai->storage == ArgHFA || ai->storage == ArgVtypeOnStack || (ai->storage == ArgVtypeInIRegs && args [i].cls == X64_BYPTR);
+		if (need_slot) {
+			args [i].slot = spill;
+			spill += arm64ec_align16 (ai->size);
+		}
+	}
+	if (cinfo->ret.storage == ArgHFA || (hidden && cinfo->ret.storage != ArgVtypeByRef)) {
+		retslot = spill;
+		spill += arm64ec_align16 (cinfo->ret.size);
+	}
+	frame = arm64ec_align16 (spill + 16);
+	stack_base = frame;
+
+	arm_subx_imm (code, ARMREG_SP, ARMREG_SP, frame);
+	arm_strx (code, ARMREG_FP, ARMREG_SP, frame - 16);
+	arm_strx (code, ARMREG_LR, ARMREG_SP, frame - 8);
+	arm_addx_imm (code, ARMREG_FP, ARMREG_SP, frame - 16);
+
+	/* phase 1: every register source into the frame (image or aggregate slot) */
+	for (i = 0; i < nargs; ++i) {
+		ArgInfo *ai = args [i].ainfo;
+
+		if (args [i].slot >= 0) {
+			code = arm64ec_spill_to_slot (code, ai, stack_base, args [i].slot);
+			continue;
+		}
+		switch (ai->storage) {
+		case ArgInIReg:
+		case ArgVtypeInIRegs:
+		case ArgVtypeByRef:
+			arm_strx (code, ai->reg, ARMREG_SP, IMG_INT (img, ai->reg));
+			break;
+		case ArgInFReg:
+		case ArgInFRegR4:
+			arm_strfpx (code, ai->reg, ARMREG_SP, IMG_FP (img, ai->reg));
+			break;
+		default:
+			break; /* entry-stack arguments are read in place */
+		}
+	}
+
+	/* phase 2: destinations, loads only */
+	for (i = 0; i < nargs; ++i) {
+		ThunkArg *a = &args [i];
+
+		if (a->pos < 4) {
+			code = arm64ec_exit_value (code, a, img, stack_base, a->pos, a->pos);
+		} else {
+			int dst = 0x20 + 8 * (a->pos - 4);
+
+			code = arm64ec_exit_value (code, a, img, stack_base, ARMREG_IP1, ARMREG_D16);
+			if (a->cls == X64_FP64)
+				arm_strfpx (code, ARMREG_D16, ARMREG_SP, dst);
+			else if (a->cls == X64_FP32)
+				arm_strfpw (code, ARMREG_D16, ARMREG_SP, dst);
+			else
+				arm_strx (code, ARMREG_IP1, ARMREG_SP, dst);
+		}
+	}
+	if (hidden) {
+		if (cinfo->ret.storage == ArgVtypeByRef)
+			arm_movx (code, ARMREG_R0, ARMREG_R8);
+		else
+			arm_addx_imm (code, ARMREG_R0, ARMREG_SP, retslot);
+	}
+
+	code = emit_imm64 (code, ARMREG_IP0, (guint64)(gsize)&__os_arm64x_dispatch_call_no_redirect);
+	arm_ldrx (code, ARMREG_IP0, ARMREG_IP0, 0);
+	arm_blrx (code, ARMREG_IP0);
+
+	switch (cinfo->ret.storage) {
+	case ArgNone:
+	case ArgInFReg:
+	case ArgInFRegR4:
+	case ArgVtypeByRef: /* the x64 callee filled the caller's buffer */
+		break;
+	case ArgInIReg:
+		arm_movx (code, ARMREG_R0, ARMREG_R8);
+		break;
+	case ArgVtypeInIRegs:
+		if (retcls == X64_INT) {
+			arm_movx (code, ARMREG_R0, ARMREG_R8);
+		} else {
+			for (k = 0; k < cinfo->ret.nregs; ++k)
+				arm_ldrx (code, ARMREG_R0 + k, ARMREG_SP, retslot + 8 * k);
+		}
+		break;
+	case ArgHFA:
+		if (retcls == X64_INT)
+			arm_strx (code, ARMREG_R8, ARMREG_SP, retslot);
+		for (k = 0; k < cinfo->ret.nregs; ++k) {
+			if (cinfo->ret.esize == 4)
+				arm_ldrfpw (code, cinfo->ret.reg + k, ARMREG_SP, retslot + cinfo->ret.foffsets [k]);
+			else
+				arm_ldrfpx (code, cinfo->ret.reg + k, ARMREG_SP, retslot + cinfo->ret.foffsets [k]);
+		}
+		break;
+	default:
+		g_assert_not_reached ();
+	}
+
+	arm_ldrx (code, ARMREG_FP, ARMREG_SP, frame - 16);
+	arm_ldrx (code, ARMREG_LR, ARMREG_SP, frame - 8);
+	arm_addx_imm (code, ARMREG_SP, ARMREG_SP, frame);
+	arm_retx (code, ARMREG_LR);
+	return code;
+}
+
+/*
+ * The entry thunk for a native-to-managed wrapper. The emulator arrives here with x9 = the wrapper,
+ * x0-x3 / v0-v3 = the first four x64 arguments by position, x4 = the x64 stack pointer (shadow space at
+ * +0, the fifth argument at +0x20) and lr = the x64 return address.
+ */
+static guint8*
+arm64ec_emit_entry_thunk (guint8 *code, MonoMethodSignature *sig, CallInfo *cinfo)
+{
+	int nargs = cinfo->nargs, i, k;
+	int retsize = arm64ec_type_size (sig->ret, sig->pinvoke);
+	X64Class retcls = arm64ec_x64_class (&cinfo->ret, retsize);
+	gboolean hidden = (retcls == X64_BYPTR);
+	int img = cinfo->stack_usage;
+	int spill = img + IMG_SIZE;
+	int retsave, tmp, frame;
+	ThunkArg *args = g_newa (ThunkArg, nargs + 1);
+
+	if (!arm64ec_thunk_supported (sig, cinfo, "entry thunk")) {
+		arm_brk (code, 0xec);
+		return code;
+	}
+
+	code = emit_qpair (code, FALSE, 6, 7, ARMREG_SP, -176, 3);
+	code = emit_qpair (code, FALSE, 8, 9, ARMREG_SP, 32, 2);
+	code = emit_qpair (code, FALSE, 10, 11, ARMREG_SP, 64, 2);
+	code = emit_qpair (code, FALSE, 12, 13, ARMREG_SP, 96, 2);
+	code = emit_qpair (code, FALSE, 14, 15, ARMREG_SP, 128, 2);
+	arm_stpx (code, ARMREG_FP, ARMREG_LR, ARMREG_SP, 160);
+	arm_addx_imm (code, ARMREG_FP, ARMREG_SP, 160);
+
+	for (i = 0; i < nargs; ++i) {
+		ArgInfo *ai = &cinfo->args [i];
+
+		args [i].pos = i + hidden;
+		args [i].size = arm64ec_arg_size (sig, i);
+		args [i].cls = arm64ec_x64_class (ai, args [i].size);
+		args [i].ainfo = ai;
+		args [i].slot = -1;
+		if (ai->storage == ArgHFA && args [i].cls == X64_INT) {
+			/* an 8-byte HFA arrives as a bit pattern in an integer register: unpack it through memory */
+			args [i].slot = spill;
+			spill += 16;
+		}
+	}
+	retsave = spill;
+	tmp = spill + 8;
+	spill += 16;
+	frame = arm64ec_align16 (spill);
+	arm_subx_imm (code, ARMREG_SP, ARMREG_SP, frame);
+	arm_movx (code, ARMREG_IP0, ARMREG_R4); /* x16 = the x64 stack, kept across the argument moves */
+
+	/* phase 1: the x64 register image (only the positions that exist) */
+	for (i = 0; i < nargs + hidden && i < 4; ++i) {
+		arm_strx (code, i, ARMREG_SP, IMG_INT (img, i));
+		arm_strfpx (code, i, ARMREG_SP, IMG_FP (img, i));
+	}
+	if (hidden) {
+		arm_strx (code, ARMREG_R0, ARMREG_SP, retsave);
+		if (cinfo->ret.storage == ArgVtypeByRef)
+			arm_movx (code, ARMREG_R8, ARMREG_R0);
+	}
+
+	/* phase 2: each argument from the image or the x64 stack into its AAPCS64 home */
+	for (i = 0; i < nargs; ++i) {
+		ThunkArg *a = &args [i];
+		ArgInfo *ai = a->ainfo;
+		int xsrc = ARMREG_IP1, fsrc = ARMREG_D16;
+
+		if (a->cls == X64_INT || a->cls == X64_BYPTR) {
+			if (a->pos < 4)
+				arm_ldrx (code, ARMREG_IP1, ARMREG_SP, IMG_INT (img, a->pos));
+			else
+				arm_ldrx (code, ARMREG_IP1, ARMREG_IP0, 0x20 + 8 * (a->pos - 4));
+		} else {
+			if (a->pos < 4)
+				arm_ldrfpx (code, ARMREG_D16, ARMREG_SP, IMG_FP (img, a->pos));
+			else
+				arm_ldrfpx (code, ARMREG_D16, ARMREG_IP0, 0x20 + 8 * (a->pos - 4));
+		}
+
+		switch (ai->storage) {
+		case ArgInIReg:
+			arm_movx (code, ai->reg, xsrc);
+			break;
+		case ArgOnStack:
+			arm_strx (code, xsrc, ARMREG_SP, ai->offset);
+			break;
+		case ArgInFReg:
+			arm_fmovd (code, ai->reg, fsrc);
+			break;
+		case ArgInFRegR4:
+			arm_fmovs (code, ai->reg, fsrc);
+			break;
+		case ArgOnStackR8:
+			arm_strfpx (code, fsrc, ARMREG_SP, ai->offset);
+			break;
+		case ArgOnStackR4:
+			arm_strfpw (code, fsrc, ARMREG_SP, ai->offset);
+			break;
+		case ArgVtypeInIRegs:
+			if (a->cls == X64_INT) {
+				arm_movx (code, ai->reg, xsrc);
+			} else {
+				for (k = 0; k < ai->nregs; ++k)
+					arm_ldrx (code, ai->reg + k, xsrc, 8 * k);
+			}
+			break;
+		case ArgVtypeByRef:
+			arm_movx (code, ai->reg, xsrc);
+			break;
+		case ArgVtypeByRefOnStack:
+			arm_strx (code, xsrc, ARMREG_SP, ai->offset);
+			break;
+		case ArgVtypeOnStack:
+			if (a->cls == X64_INT) {
+				arm_strx (code, xsrc, ARMREG_SP, ai->offset);
+			} else {
+				for (k = 0; k < ai->size; k += 8) {
+					arm_ldrfpx (code, ARMREG_D16, xsrc, k);
+					arm_strfpx (code, ARMREG_D16, ARMREG_SP, ai->offset + k);
+				}
+			}
+			break;
+		case ArgHFA: {
+			int base, boff;
+
+			if (a->cls == X64_INT) {
+				arm_strx (code, xsrc, ARMREG_SP, a->slot);
+				base = ARMREG_SP;
+				boff = a->slot;
+			} else {
+				base = xsrc;
+				boff = 0;
+			}
+			for (k = 0; k < ai->nregs; ++k) {
+				if (ai->esize == 4)
+					arm_ldrfpw (code, ai->reg + k, base, boff + ai->foffsets [k]);
+				else
+					arm_ldrfpx (code, ai->reg + k, base, boff + ai->foffsets [k]);
+			}
+			break;
+		}
+		default:
+			g_assert_not_reached ();
+		}
+	}
+
+	arm_blrx (code, ARMREG_R9);
+
+	switch (cinfo->ret.storage) {
+	case ArgNone:
+	case ArgInFReg:
+	case ArgInFRegR4:
+		break;
+	case ArgInIReg:
+		arm_movx (code, ARMREG_R8, ARMREG_R0);
+		break;
+	case ArgVtypeByRef:
+		arm_ldrx (code, ARMREG_R8, ARMREG_SP, retsave);
+		break;
+	case ArgVtypeInIRegs:
+		if (retcls == X64_INT) {
+			arm_movx (code, ARMREG_R8, ARMREG_R0);
+		} else {
+			/* exactly size bytes: the x64 caller's buffer is no larger than the struct */
+			int left = retsize;
+
+			arm_ldrx (code, ARMREG_R9, ARMREG_SP, retsave);
+			for (k = 0; k < cinfo->ret.nregs && left > 0; ++k, left -= 8)
+				code = arm64ec_store_bytes (code, ARMREG_R0 + k, ARMREG_R9, 8 * k, MIN (left, 8), tmp);
+			arm_movx (code, ARMREG_R8, ARMREG_R9);
+		}
+		break;
+	case ArgHFA: {
+		int base, boff;
+
+		if (retcls == X64_INT) {
+			base = ARMREG_SP;
+			boff = retsave;
+		} else {
+			arm_ldrx (code, ARMREG_IP1, ARMREG_SP, retsave);
+			base = ARMREG_IP1;
+			boff = 0;
+		}
+		for (k = 0; k < cinfo->ret.nregs; ++k) {
+			if (cinfo->ret.esize == 4)
+				arm_strfpw (code, cinfo->ret.reg + k, base, boff + cinfo->ret.foffsets [k]);
+			else
+				arm_strfpx (code, cinfo->ret.reg + k, base, boff + cinfo->ret.foffsets [k]);
+		}
+		if (retcls == X64_INT)
+			arm_ldrx (code, ARMREG_R8, ARMREG_SP, retsave);
+		else
+			arm_movx (code, ARMREG_R8, ARMREG_IP1);
+		break;
+	}
+	default:
+		g_assert_not_reached ();
+	}
+
+	arm_addx_imm (code, ARMREG_SP, ARMREG_SP, frame);
+	code = emit_imm64 (code, ARMREG_IP0, (guint64)(gsize)&__os_arm64x_dispatch_ret);
+	arm_ldrx (code, ARMREG_IP0, ARMREG_IP0, 0);
+	arm_ldpx (code, ARMREG_FP, ARMREG_LR, ARMREG_SP, 160);
+	code = emit_qpair (code, TRUE, 14, 15, ARMREG_SP, 128, 2);
+	code = emit_qpair (code, TRUE, 12, 13, ARMREG_SP, 96, 2);
+	code = emit_qpair (code, TRUE, 10, 11, ARMREG_SP, 64, 2);
+	code = emit_qpair (code, TRUE, 8, 9, ARMREG_SP, 32, 2);
+	code = emit_qpair (code, TRUE, 6, 7, ARMREG_SP, 176, 1);
+	arm_brx (code, ARMREG_IP0);
+	return code;
+}
+
+/* Exit thunks are shared by argument/return SHAPE (the signature pointer itself may be recycled). */
+static GHashTable *arm64ec_exit_thunks;
+
+static char*
+arm64ec_shape_key (MonoMethodSignature *sig, CallInfo *cinfo)
+{
+	GString *s = g_string_new ("");
+	int i, k;
+	ArgInfo *ai;
+
+	g_string_append_printf (s, "cc%d|", sig->call_convention);
+	for (i = -1; i < cinfo->nargs; ++i) {
+		ai = i < 0 ? &cinfo->ret : &cinfo->args [i];
+		g_string_append_printf (s, "%d:%d:%d:%d:%d:%d:%d", ai->storage, ai->reg, ai->offset, ai->nregs, ai->size, ai->esize,
+			ai->storage == ArgNone ? 0 : (i < 0 ? arm64ec_type_size (sig->ret, sig->pinvoke) : arm64ec_arg_size (sig, i)));
+		for (k = 0; k < 4; ++k)
+			g_string_append_printf (s, ".%d", ai->foffsets [k]);
+		g_string_append_c (s, '|');
+	}
+	return g_string_free (s, FALSE);
+}
+
+gpointer
+mono_arm64ec_get_exit_thunk (MonoMethodSignature *sig)
+{
+	CallInfo *cinfo = get_call_info (NULL, sig);
+	char *key = arm64ec_shape_key (sig, cinfo);
+	gpointer res;
+
+	mono_os_mutex_lock (&arm64ec_thunk_mutex);
+	if (!arm64ec_exit_thunks)
+		arm64ec_exit_thunks = g_hash_table_new (g_str_hash, g_str_equal);
+	res = g_hash_table_lookup (arm64ec_exit_thunks, key);
+	if (!res) {
+		guint8 buf [4096], *end;
+		int size;
+
+		end = arm64ec_emit_exit_thunk (buf, sig, cinfo);
+		size = end - buf;
+		g_assert (size <= sizeof (buf));
+		res = mono_mem_manager_code_reserve (mono_domain_memory_manager (mono_get_root_domain ()), size);
+		memcpy (res, buf, size);
+		mono_arch_flush_icache ((guint8 *)res, size);
+		if (g_getenv ("MONO_ARM64EC_DEBUG")) {
+			char *name = mono_signature_get_desc (sig, TRUE);
+			g_print ("ARM64EC exit thunk %p-%p for %s [%s]\n", res, (guint8 *)res + size, name, key);
+			for (int w = 0; w < size / 4; ++w)
+				g_print ("%s%08x", w ? " " : "ARM64EC words: ", ((guint32 *)res) [w]);
+			g_print ("\n");
+			g_free (name);
+		}
+		g_hash_table_insert (arm64ec_exit_thunks, key, res);
+		key = NULL;
+	}
+	mono_os_mutex_unlock (&arm64ec_thunk_mutex);
+	g_free (key);
+	g_free (cinfo);
+	return res;
+}
+
+/*
+ * Is @addr EC code (the OS bitmap wine keeps per process)? A p/invoke whose target is known at JIT
+ * time to be EC code — every internal call into this DLL, any EC game DLL — gets a plain call: no
+ * checker, no thunk. Fast-forward stubs are x64 bytes and stay on the checked path.
+ */
+static gboolean
+arm64ec_is_ec_code (gconstpointer addr)
+{
+	static BOOLEAN (NTAPI *is_ec_code) (ULONG_PTR) = NULL;
+	static gboolean resolved = FALSE;
+
+	if (!resolved) {
+		HMODULE ntdll = GetModuleHandleW (L"ntdll.dll");
+		if (ntdll)
+			is_ec_code = (BOOLEAN (NTAPI *) (ULONG_PTR))GetProcAddress (ntdll, "RtlIsEcCode");
+		resolved = TRUE;
+	}
+	return is_ec_code && is_ec_code ((ULONG_PTR)addr);
+}
+
+/* x11 = target already loaded: the checked call sequence (see the header comment) */
+static guint8*
+emit_arm64ec_checked_call (MonoCompile *cfg, guint8 *code, MonoMethodSignature *sig)
+{
+	code = emit_imm64 (code, ARMREG_R10, (guint64)(gsize)mono_arm64ec_get_exit_thunk (sig));
+	code = emit_imm64 (code, ARMREG_IP0, (guint64)(gsize)&__os_arm64x_check_icall);
+	arm_ldrx (code, ARMREG_IP0, ARMREG_IP0, 0);
+	arm_blrx (code, ARMREG_IP0);
+	arm_blrx (code, ARMREG_R11);
+	return code;
+}
+
+/* The prefix mono_codegen reserves in front of a native-to-managed wrapper: the entry thunk + the offset word. */
+guint
+mono_arm64ec_entry_thunk_size (MonoCompile *cfg)
+{
+	guint8 buf [4096], *end;
+
+	if (cfg->method->wrapper_type != MONO_WRAPPER_NATIVE_TO_MANAGED)
+		return 0;
+	end = arm64ec_emit_entry_thunk (buf, mono_method_signature_internal (cfg->method), cfg->arch.cinfo);
+	return arm64ec_align16 (end - buf + 4);
+}
+
+void
+mono_arm64ec_emit_entry_thunk (MonoCompile *cfg, guint8 *prefix, guint len)
+{
+	guint8 *end = arm64ec_emit_entry_thunk (prefix, mono_method_signature_internal (cfg->method), cfg->arch.cinfo);
+
+	g_assert (end <= prefix + len - 4);
+	/* the offset from the function entry back to the thunk; bit 0 marks it valid */
+	*(gint32 *)(prefix + len - 4) = (gint32)(-(gint32)len) | 1;
+	mono_arch_flush_icache (prefix, len);
+	if (g_getenv ("MONO_ARM64EC_DEBUG")) {
+		char *name = mono_method_full_name (cfg->method, TRUE);
+		g_print ("ARM64EC entry thunk %p-%p for %s (entry %p)\n", prefix, end, name, prefix + len);
+		g_free (name);
+	}
+}
